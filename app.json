{
  "expo": {
    "name": "VitaCare",
    "slug": "vitacare",
    "owner": "briam.carrascodev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vitacare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.vitacare.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B2D31",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 260
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#00987A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VitaCare necesita acceso a tus fotos para que puedas elegir tu foto de perfil.",
          "cameraPermission": "VitaCare necesita acceso a la cámara para que puedas tomarte una foto de perfil."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4469ce0a-48db-4628-a1f1-7c16340db09a"
      }
    }
  }
}
